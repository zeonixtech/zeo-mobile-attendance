{
  "name": "attendance-app",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "android:prepare": "ionic build && node -e \"const fs=require('fs'),p='platforms/android/www';if(fs.existsSync(p)){fs.rmSync(p,{recursive:true})}fs.cpSync('www',p,{recursive:true})\"",
    "android:build": "npm run android:prepare && cordova build android",
    "android:run": "npm run android:prepare && cordova run android",
    "android:open": "cordova platform add android",
    "install:plugins": "cordova plugin add ./native-plugins/cordova-plugin-background-location --nofetch && cordova plugin add ./native-plugins/cordova-plugin-ble-beacon --nofetch",
    "postinstall": "npm run install:plugins"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.25",
    "@angular/common": "20.3.25",
    "@angular/compiler": "20.3.25",
    "@angular/core": "20.3.25",
    "@angular/forms": "20.3.25",
    "@angular/platform-browser": "20.3.25",
    "@angular/platform-browser-dynamic": "20.3.25",
    "@angular/router": "20.3.25",
    "@awesome-cordova-plugins/in-app-browser": "^9.2.0",
    "@ionic/angular": "^8.0.0",
    "angular-oauth2-oidc": "^20.0.3",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-geolocation": "^5.0.0",
    "ionicons": "^7.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.28",
    "@angular-eslint/builder": "20.7.0",
    "@angular-eslint/eslint-plugin": "20.7.0",
    "@angular-eslint/eslint-plugin-template": "20.7.0",
    "@angular-eslint/schematics": "20.7.0",
    "@angular-eslint/template-parser": "20.7.0",
    "@angular/cli": "20.3.28",
    "@angular/compiler-cli": "20.3.25",
    "@angular/language-service": "20.3.25",
    "@ionic/angular-toolkit": "^12.0.0",
    "@ionic/cordova-builders": "^12.3.0",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "cordova-android": "^15.0.0",
    "cordova-plugin-android-permissions": "^1.1.5",
    "cordova-plugin-background-location": "file:native-plugins/cordova-plugin-background-location",
    "cordova-plugin-ble-beacon": "file:native-plugins/cordova-plugin-ble-beacon",
    "cordova-plugin-customurlscheme": "^5.0.2",
    "cordova-plugin-inappbrowser": "^7.0.0",
    "cordova-plugin-ionic-keyboard": "^2.0.5",
    "cordova-plugin-ionic-webview": "^5.0.0",
    "cordova-plugin-request-location-accuracy": "^2.3.0",
    "cordova-plugin-splashscreen": "5.0.2",
    "cordova-plugin-statusbar": "^2.4.2",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.0"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "esbuild": "^0.28.1",
    "@angular-devkit/build-angular": {
      "http-proxy-middleware": "^3.0.7"
    },
    "piscina": "^5.2.0",
    "uuid": "^11.1.1",
    "vite": "^7.3.5",
    "webpack-dev-server": "^5.2.5"
  },
  "description": "An Ionic project",
  "cordova": {
    "plugins": {
      "cordova-plugin-statusbar": {},
      "cordova-plugin-device": {},
      "cordova-plugin-splashscreen": {},
      "cordova-plugin-ionic-webview": {},
      "cordova-plugin-ionic-keyboard": {},
      "cordova-plugin-geolocation": {
        "GPS_REQUIRED": "true"
      },
      "cordova-plugin-request-location-accuracy": {
        "PLAY_SERVICES_LOCATION_VERSION": "16.+"
      },
      "cordova-plugin-inappbrowser": {},
      "cordova-plugin-customurlscheme": {
        "URL_SCHEME": "zeohrmapp",
        "ANDROID_SCHEME": " ",
        "ANDROID_HOST": " ",
        "ANDROID_PATHPREFIX": "/"
      },
      "cordova-plugin-android-permissions": {},
      "cordova-plugin-background-location": {},
      "cordova-plugin-ble-beacon": {}
    },
    "platforms": [
      "android"
    ]
  }
}
